    ("Fonte", item.fields.source),
    ("Requisiti software derivati", m.links_to(item, "derives_from", "SRS") | ids),
    ("Validato da", m.links_to(item, "validates") | ids),
]) }}{% endmacro %}
## Stakeholder (DI-TPL-02 §2)

{{ empty(urs) }}
{% for group in urs | map(attribute="fields.stakeholder") | unique | sort %}
